# Variables para ejecutar el backend localmente con Netlify CLI (`npx netlify dev`).
# En Netlify estas variables se configuran en el panel:
#   Site configuration > Build & deploy > Environment variables
REDIS_HOST=redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com
REDIS_PORT=12345
REDIS_USER=default
REDIS_PSW=su-password-de-redis-cloud
REDIS_TLS=true

# Opcionales
UPDATES_LIST=bookstore
# BATCH_TOKEN=un-token-compartido-entre-tasks-y-batch
# CORS_ORIGIN=https://su-frontend.vercel.app
